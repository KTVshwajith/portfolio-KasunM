---
const { category } = Astro.props;
import { tutorials } from "../data/tutorials.js";
import { labs } from "../data/labs.js";
const base = import.meta.env.BASE_URL;
const count = tutorials.filter((t) => t.category === category.slug).length + labs.filter((l) => l.category === category.slug).length;
---
<a class="category-card" href={`${base}categories/${category.slug}/`}>
  <div class="card-top">
    <span class="card-icon">{category.icon}</span>
    {count === 0 ? <span class="pill soon">Coming soon</span> : <span class="card-number">{category.number}</span>}
  </div>
  <h3>{category.title}</h3>
  <p>{category.short}</p>
  <span class="card-link">Explore topic →</span>
</a>
