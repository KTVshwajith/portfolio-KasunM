---
import { site } from "../data/site.js";
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Home", href: base },
  { label: "Learning Hub", href: `${base}learning/` },
  { label: "Tutorials", href: `${base}tutorials/` },
  { label: "Labs", href: `${base}labs/` },
  { label: "About", href: `${base}about/` },
  { label: "Portfolio ↗", href: "https://ktvshwajith.github.io/portfolio-KasunM/" }
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={base} aria-label={`${site.name} home`}>
      <span class="brand-mark">⌘</span>
      <span>{site.name}<small>{site.byline}</small></span>
    </a>
    <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-label="Toggle navigation">Menu</button>
    <nav class="nav-links" data-nav aria-label="Main navigation">
      {links.map((link) => <a class={path === link.href || (link.label === "Learning Hub" && path.includes("/categories/")) ? "active" : ""} href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>
