---
const { tutorial } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="tutorial-card" href={`${base}tutorials/${tutorial.slug}/`}>
  <div class="tutorial-meta">
    <span class="pill">{tutorial.level}</span>
    <span class="card-number">{tutorial.time}</span>
  </div>
  <h3>{tutorial.title}</h3>
  <p>{tutorial.summary}</p>
  <span class="card-link">Read tutorial →</span>
</a>
