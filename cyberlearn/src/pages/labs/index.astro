---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { labSections, labs } from "../../data/labs.js";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Interactive Labs" description="Hands-on cryptography and security labs that run entirely in your browser.">
  <section class="page-hero"><div class="container">
    <div class="breadcrumb">LABS</div>
    <h1>Interactive labs</h1>
    <p>{labs.length} hands-on labs covering the cryptography and security techniques in everyday use today. Each one runs entirely in your browser using the standard Web Crypto API, so nothing you type is sent anywhere.</p>
    <nav class="toc" aria-label="Lab topics">
      {labSections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
  </div></section>
  <section class="section"><div class="container lab-index">
    {labSections.map((section) => (
      <section id={section.id}>
        <div>
          <div class="kicker">{section.labs.length} {section.labs.length === 1 ? "lab" : "labs"}</div>
          <h2>{section.title}</h2>
          <p class="intro">{section.intro}</p>
        </div>
        <div class="lab-list">
          {section.labs.map((lab) => (
            <a href={`${base}labs/${lab.slug}/`}>
              <b>{lab.title}</b><span class="pill">{lab.tag}</span>
              <span class="desc">{lab.desc}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div></section>
</BaseLayout>
