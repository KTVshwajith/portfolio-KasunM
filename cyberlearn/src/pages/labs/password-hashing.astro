---
import LabLayout from "../../layouts/LabLayout.astro";
---
<LabLayout slug="password-hashing">
  <div class="cols">
    <div class="field">
      <label for="pw">Password (use a made-up one)</label>
      <input id="pw" type="text" value="summer2026" />
    </div>
    <div class="field">
      <label for="iter">Iterations</label>
      <select id="iter">
        <option value="1">1 (no stretching, like a plain hash)</option>
        <option value="10000">10,000</option>
        <option value="100000">100,000</option>
        <option value="600000" selected>600,000 (OWASP guidance for PBKDF2-SHA256)</option>
        <option value="2000000">2,000,000</option>
      </select>
    </div>
  </div>
  <div class="row">
    <button id="salt" type="button" class="alt">New random salt</button>
    <button id="derive" type="button">Derive key</button>
  </div>
  <table>
    <tbody>
      <tr><th>Salt (128-bit)</th><td id="saltv">—</td></tr>
      <tr><th>Derived key (256-bit)</th><td id="dk">—</td></tr>
      <tr><th>Time taken</th><td id="time">—</td></tr>
      <tr><th>Attacker guesses / second / core (estimate)</th><td id="rate">—</td></tr>
    </tbody>
  </table>
  <div class="out" id="note">Derive twice with the same salt and you get the same key. Change the salt and the key changes completely.</div>

  <Fragment slot="notes">
    <h2>Why salt and iterations?</h2>
    <ul>
      <li><strong>Salt:</strong> a random value stored next to each password hash. Two users with the same password get different hashes, and pre-computed "rainbow tables" become useless.</li>
      <li><strong>Iterations:</strong> the hash is repeated many times so each guess costs the attacker real time. A login that takes a fraction of a second is unnoticeable to a user, but it turns billions of guesses per second into thousands.</li>
    </ul>
    <div class="article-callout"><strong>Current practice</strong><br />OWASP's Password Storage Cheat Sheet recommends <strong>Argon2id</strong> first, then scrypt or bcrypt. Use PBKDF2 with at least 600,000 iterations of SHA-256 where FIPS compliance is needed. Browsers only provide PBKDF2 natively, which is why it's the one shown here.</div>
  </Fragment>
</LabLayout>

<script>
  import { $, enc, toHex, randomBytes, show, requireWebCrypto } from "../../scripts/cryptoUtils.js";
  let salt = randomBytes(16);
  const newSalt = () => { salt = randomBytes(16); $("#saltv").textContent = toHex(salt); derive(); };
  async function derive() {
    const iterations = Number($("#iter").value);
    $("#derive").disabled = true; $("#time").textContent = "working…";
    await new Promise((r) => setTimeout(r, 20));
    const base = await crypto.subtle.importKey("raw", enc.encode($("#pw").value), "PBKDF2", false, ["deriveBits"]);
    const t0 = performance.now();
    const bits = await crypto.subtle.deriveBits({ name: "PBKDF2", salt, iterations, hash: "SHA-256" }, base, 256);
    const ms = performance.now() - t0;
    $("#saltv").textContent = toHex(salt);
    $("#dk").textContent = toHex(bits);
    $("#time").textContent = `${ms.toFixed(1)} ms for ${iterations.toLocaleString()} iteration${iterations === 1 ? "" : "s"}`;
    const perSec = ms > 0 ? Math.round(1000 / ms) : Infinity;
    $("#rate").textContent = Number.isFinite(perSec) ? `about ${perSec.toLocaleString()} on hardware like yours` : "too fast to measure";
    show("#note", iterations === 1
      ? "With 1 iteration, an attacker with a GPU can test billions of guesses per second. Common passwords fall instantly."
      : "Each guess now costs the attacker this much work, per password and per salt.", iterations === 1 ? "bad" : "ok");
    $("#derive").disabled = false;
  }
  if (requireWebCrypto()) {
    $("#salt").addEventListener("click", newSalt);
    $("#derive").addEventListener("click", derive);
    $("#iter").addEventListener("change", derive);
    derive();
  }
</script>
