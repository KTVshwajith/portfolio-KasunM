---
import LabLayout from "../../layouts/LabLayout.astro";
---
<LabLayout slug="password-strength">
  <div class="field">
    <label for="pw">Password or passphrase (use a made-up one)</label>
    <input id="pw" type="text" value="Tr0ub4dor&3" />
  </div>
  <div class="field">
    <label for="speed">Attacker speed</label>
    <select id="speed">
      <option value="10">10 / second (online login with rate limiting)</option>
      <option value="10000">10 thousand / second (slow hash, e.g. bcrypt)</option>
      <option value="10000000000" selected>10 billion / second (fast hash on a GPU rig)</option>
    </select>
  </div>
  <table>
    <tbody>
      <tr><th>Length</th><td id="len">—</td></tr>
      <tr><th>Character sets used</th><td id="sets">—</td></tr>
      <tr><th>Brute-force entropy</th><td id="bits">—</td></tr>
      <tr><th>Time to try every combination</th><td id="time">—</td></tr>
    </tbody>
  </table>
  <div class="out" id="warn"></div>

  <Fragment slot="notes">
    <h2>How to read this</h2>
    <p>The estimate assumes a pure brute-force attack: every combination of the character types you used, up to your length. Real attackers start with wordlists, leaked passwords and common substitutions (a→@, o→0), so a password built from a dictionary word is far weaker than its "entropy" suggests. The lab warns you when it spots those patterns.</p>
    <div class="article-callout"><strong>Better approach</strong><br />Length beats complexity. Four or more random, unrelated words make a passphrase that is long and memorable. Better still, use a password manager to generate unique passwords, and turn on multi-factor authentication or passkeys wherever you can. This follows NIST SP 800-63B.</div>
  </Fragment>
</LabLayout>

<script>
  import { $, show } from "../../scripts/cryptoUtils.js";
  const common = ["password", "123456", "qwerty", "letmein", "welcome", "admin", "iloveyou", "monkey", "dragon", "summer", "winter", "spring", "autumn", "football", "baseball", "sunshine", "princess", "troub", "abc123", "111111", "kiaora", "auckland", "newzealand"];
  function human(sec) {
    if (!Number.isFinite(sec)) return "effectively forever";
    const units = [["years", 31557600], ["days", 86400], ["hours", 3600], ["minutes", 60], ["seconds", 1]];
    for (const [u, s] of units) if (sec >= s) {
      const v = sec / s;
      if (u === "years" && v > 1e9) return `${v.toExponential(1)} years${v > 1.4e10 ? " (longer than the age of the universe)" : ""}`;
      return `${v < 10 ? v.toFixed(1) : Math.round(v).toLocaleString()} ${u}`;
    }
    return "instantly";
  }
  function run() {
    const pw = $("#pw").value;
    const sets = [];
    let pool = 0;
    if (/[a-z]/.test(pw)) { pool += 26; sets.push("lowercase"); }
    if (/[A-Z]/.test(pw)) { pool += 26; sets.push("uppercase"); }
    if (/[0-9]/.test(pw)) { pool += 10; sets.push("digits"); }
    if (/[^a-zA-Z0-9]/.test(pw)) { pool += 33; sets.push("symbols"); }
    const len = [...pw].length;
    const bits = len && pool ? len * Math.log2(pool) : 0;
    const seconds = Math.pow(2, bits) / Number($("#speed").value);
    $("#len").textContent = `${len} characters`;
    $("#sets").textContent = sets.join(", ") || "—";
    $("#bits").textContent = `${bits.toFixed(1)} bits`;
    $("#time").textContent = human(seconds);
    const lower = pw.toLowerCase().replace(/[@4]/g, "a").replace(/0/g, "o").replace(/[1!]/g, "i").replace(/3/g, "e").replace(/\$/g, "s");
    const hit = common.find((w) => lower.includes(w));
    const warnings = [];
    if (hit) warnings.push(`Contains a common word or pattern ("${hit}"). Wordlist attacks try these first, so the real strength is much lower.`);
    if (/(.)\1\1/.test(pw)) warnings.push("Contains a character repeated three or more times.");
    if (/(19|20)\d\d/.test(pw)) warnings.push("Contains what looks like a year, a very common pattern.");
    if (len < 12) warnings.push("Shorter than 12 characters.");
    show("#warn", warnings.length ? "⚠ " + warnings.join("\n⚠ ") : "No obvious patterns found. Length and randomness are doing the work.", warnings.length ? "bad" : "ok");
  }
  $("#pw").addEventListener("input", run);
  $("#speed").addEventListener("change", run);
  run();
</script>
