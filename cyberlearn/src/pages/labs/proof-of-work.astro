---
import LabLayout from "../../layouts/LabLayout.astro";
---
<LabLayout slug="proof-of-work">
  <div class="cols">
    <div class="field">
      <label for="diff">Difficulty (leading zero hex digits)</label>
      <select id="diff">
        <option value="2">2 (about 256 tries)</option>
        <option value="3" selected>3 (about 4,096 tries)</option>
        <option value="4">4 (about 65,536 tries)</option>
        <option value="5">5 (about 1 million tries, slow)</option>
      </select>
    </div>
    <div class="field">
      <label>&nbsp;</label>
      <div class="row"><button id="mineall" type="button">Mine all blocks</button><button id="add" type="button" class="alt">Add block</button></div>
    </div>
  </div>
  <div class="chain" id="chain"></div>
  <div class="out" id="status">—</div>

  <Fragment slot="notes">
    <h2>What to try</h2>
    <ol>
      <li>Mine the chain. Every block turns green, and each one stores the hash of the block before it.</li>
      <li>Edit the data in block 2. Its hash no longer meets the difficulty, and every later block breaks too, because each block's hash includes the previous block's hash.</li>
      <li>Re-mine block 2 and the ones after it to repair the chain. Notice how much work rewriting history costs, and how it grows with difficulty.</li>
    </ol>
    <div class="article-callout"><strong>In the real world</strong><br />Bitcoin's difficulty is set so the whole network finds a block about every 10 minutes, which takes vast numbers of hashes per second. Ethereum moved from proof of work to proof of stake in 2022 and cut its energy use by over 99%. Proof of work isn't required for tamper evidence: a simple hash chain, like the ledger in my <a class="card-link" href="https://github.com/KTVshwajith/Veriframe" target="_blank" rel="noopener">VeriFrame</a> project, already detects edits.</div>
  </Fragment>
</LabLayout>

<script>
  import { $, sha256Hex, show, requireWebCrypto } from "../../scripts/cryptoUtils.js";
  const blocks = [
    { data: "Genesis block" },
    { data: "Alice pays Bob 5" },
    { data: "Bob pays Carol 2" },
    { data: "Carol pays Dave 1" }
  ].map((b, i) => ({ ...b, index: i, nonce: 0, prev: "", hash: "" }));
  const target = () => "0".repeat(Number($("#diff").value));
  const payload = (b) => `${b.index}|${b.prev}|${b.data}|${b.nonce}`;

  async function rehashAll() {
    for (let i = 0; i < blocks.length; i++) {
      blocks[i].prev = i === 0 ? "0".repeat(64) : blocks[i - 1].hash;
      blocks[i].hash = await sha256Hex(payload(blocks[i]));
    }
  }
  async function mine(i) {
    const b = blocks[i], t = target(), t0 = performance.now();
    b.prev = i === 0 ? "0".repeat(64) : blocks[i - 1].hash;
    let tries = 0;
    for (b.nonce = 0; ; b.nonce++) {
      tries++;
      b.hash = await sha256Hex(payload(b));
      if (b.hash.startsWith(t)) break;
    }
    return { tries, ms: performance.now() - t0 };
  }
  function valid(i) {
    const b = blocks[i];
    const linked = i === 0 || b.prev === blocks[i - 1].hash;
    return linked && b.hash.startsWith(target());
  }
  function render() {
    $("#chain").innerHTML = blocks.map((b, i) => `
      <div class="block ${valid(i) ? "ok" : "bad"}">
        <div class="row" style="justify-content:space-between"><strong>Block ${i}</strong><span class="hint">${valid(i) ? "✓ valid" : "✗ invalid"}</span></div>
        <label class="hint" for="d${i}">Data</label>
        <input id="d${i}" data-i="${i}" type="text" value="${b.data.replace(/"/g, "&quot;")}" />
        <div class="hint">Nonce: ${b.nonce.toLocaleString()}</div>
        <div class="hint">Previous: ${b.prev.slice(0, 24)}…</div>
        <div class="hint">Hash: <span style="color:${b.hash.startsWith(target()) ? "#b8f0cd" : "#ffc9c4"}">${b.hash}</span></div>
        <div class="row"><button type="button" data-mine="${i}" class="alt">Mine this block</button></div>
      </div>`).join("");
    document.querySelectorAll("#chain input").forEach((el) => el.addEventListener("change", async (e) => {
      blocks[Number(e.target.dataset.i)].data = e.target.value;
      await relinkFrom(Number(e.target.dataset.i));
      render();
      show("#status", "Block edited. Its hash changed, so it and every block after it are now invalid. Re-mine to repair the chain.", "bad");
    }));
    document.querySelectorAll("[data-mine]").forEach((el) => el.addEventListener("click", async (e) => {
      const i = Number(e.target.dataset.mine);
      e.target.disabled = true; e.target.textContent = "Mining…";
      const r = await mine(i);
      await relinkFrom(i + 1);
      render();
      show("#status", `Block ${i} mined in ${r.tries.toLocaleString()} tries (${r.ms.toFixed(0)} ms).`, "ok");
    }));
  }
  async function relinkFrom(start) {
    for (let i = start; i < blocks.length; i++) {
      if (i < 0) continue;
      blocks[i].prev = i === 0 ? "0".repeat(64) : blocks[i - 1].hash;
      blocks[i].hash = await sha256Hex(payload(blocks[i]));
    }
  }
  async function mineAll() {
    $("#mineall").disabled = true;
    let total = 0; const t0 = performance.now();
    for (let i = 0; i < blocks.length; i++) {
      show("#status", `Mining block ${i}…`);
      total += (await mine(i)).tries;
    }
    render();
    show("#status", `Mined ${blocks.length} blocks in ${total.toLocaleString()} total tries (${((performance.now() - t0) / 1000).toFixed(1)} s).`, "ok");
    $("#mineall").disabled = false;
  }
  if (requireWebCrypto()) {
    $("#mineall").addEventListener("click", mineAll);
    $("#add").addEventListener("click", async () => {
      blocks.push({ index: blocks.length, data: `Transaction ${blocks.length}`, nonce: 0, prev: "", hash: "" });
      await relinkFrom(blocks.length - 1); render();
      show("#status", "New block added but not mined yet.");
    });
    $("#diff").addEventListener("change", () => { render(); show("#status", "Difficulty changed. Blocks mined at a lower difficulty may now be invalid."); });
    rehashAll().then(() => { render(); show("#status", "Blocks are not mined yet. Press “Mine all blocks”."); });
  }
</script>
