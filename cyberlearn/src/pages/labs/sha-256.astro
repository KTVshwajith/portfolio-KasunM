---
import LabLayout from "../../layouts/LabLayout.astro";
---
<LabLayout slug="sha-256">
  <div class="field">
    <label for="msg">Your message</label>
    <input id="msg" type="text" value="Hello CyberLearn Lab" />
  </div>
  <div class="row"><button id="go" type="button">Calculate SHA-256</button></div>
  <div class="out" id="out" aria-live="polite">Your digest will appear here.</div>
  <div class="hint" id="status">Updates as you type.</div>

  <Fragment slot="notes">
    <h2>What to notice</h2>
    <ul>
      <li>The output is always 256 bits, shown as 64 hexadecimal characters, whatever the input length.</li>
      <li>The same input always gives the same digest. Change one character and the digest looks completely different.</li>
      <li>There is no key, and no way to "decrypt" a digest back to the message.</li>
    </ul>
    <div class="article-callout"><strong>Security note</strong><br />Never store passwords as plain SHA-256 digests. Use a slow, salted password-hashing scheme such as Argon2id, scrypt, bcrypt or PBKDF2 (see the <a class="card-link" href="../password-hashing/">PBKDF2 lab</a>).</div>
  </Fragment>
</LabLayout>

<script>
  import { $, enc, toHex, show, requireWebCrypto } from "../../scripts/cryptoUtils.js";
  async function run() {
    const value = $("#msg").value;
    const bytes = enc.encode(value);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    show("#out", toHex(digest));
    show("#status", `${bytes.length} UTF-8 bytes in · 256-bit digest out`);
  }
  if (requireWebCrypto()) {
    $("#go").addEventListener("click", run);
    $("#msg").addEventListener("input", run);
    run();
  }
</script>
