---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TutorialCard from "../../components/TutorialCard.astro";
import { tutorials } from "../../data/tutorials.js";
---
<BaseLayout title="Tutorial Library">
  <section class="page-hero"><div class="container">
    <div class="breadcrumb">LEARNING HUB / TUTORIALS</div>
    <h1>Tutorial library</h1>
    <p>Original, structured learning notes to help you understand important ideas and connect them with practical applications.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="search-wrap"><input id="tutorial-search" type="search" placeholder="Search tutorials by topic or keyword..." aria-label="Search tutorials" /></div>
    <div class="tutorial-grid" id="tutorial-grid">
      {tutorials.map((tutorial) => <div data-search={`${tutorial.title} ${tutorial.summary} ${tutorial.category} ${tutorial.level}`.toLowerCase()}><TutorialCard tutorial={tutorial} /></div>)}
    </div>
    <p id="no-results" class="empty-state" hidden>No tutorials match your search yet.</p>
  </div></section>
  <script>
    const input = document.querySelector("#tutorial-search");
    const cards = [...document.querySelectorAll("[data-search]")];
    const empty = document.querySelector("#no-results");
    input?.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = card.dataset.search.includes(q);
        card.hidden = !match;
        if (match) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  </script>
</BaseLayout>
